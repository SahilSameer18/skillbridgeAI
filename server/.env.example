# Server Environment Configuration Example

# Port the Express server listens on
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Frontend Client URL for CORS origin validation
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection Strings (Neon)
# DATABASE_URL: Pooled connection string used at runtime by Prisma Client
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL: Direct, non-pooling connection string required by Prisma for migrations
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for token signing and verification
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI Studio API Key & Model Configuration
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Redis Connection URI (Redis Cloud / Upstash / Local)
REDIS_URL=rediss://default:your_redis_password@your_redis_host:port

# Optional: Enable custom Cloudflare/Google DNS servers for environments with broken SRV lookups (true | false)
CUSTOM_DNS=false
